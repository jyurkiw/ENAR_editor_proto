<supplement xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" type="settlement" xsi:noNamespaceSchemaLocation="../../../../schemas/supplement-template-schema.xsd">
  <cover color="white" shadow="true" shadowColor="black">
    <headerTitle>Grand Forks</headerTitle>
    <headerSubtitle>A Town in Three Pieces</headerSubtitle>
    <coverImage ref="img-cover" margin="0.5in"/>
    <footerChaser>A settlement on the Copperway</footerChaser>
    <footerSubchaser>Placeholder edition</footerSubchaser>
